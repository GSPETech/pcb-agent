"""
dwm1004c_aptwr_tag sheet module: IMU (/b12541c1-4f3e-4d66-9fb9-a4548eb5cddb/)
"""

load("@stdlib/interfaces.zen", "NotConnected", "Power", "Ground")

NET_3_3V = io("NET_3_3V", Power)
IMU_BNO_SCL = io("IMU_BNO_SCL", Net)
IMU_BNO_SDA = io("IMU_BNO_SDA", Net)
IMU_IMU_INT = io("IMU_IMU_INT", Net)
IMU_IMU_NRST = io("IMU_IMU_NRST", Net)
GND = io("GND", Ground)

IMU_ADDR_SEL = Net("IMU_ADDR_SEL")
IMU_XTAL = Net("IMU_XTAL_P")
IMU_XTAL_2 = Net("IMU_XTAL_N")
NET_U4_CAP = Net("NET_U4_CAP")
NET_U4_NBOOT_LOAD_PIN = Net("NET_U4_NBOOT_LOAD_PIN")

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

BNO055 = Module("../../components/BOSCH/BNO055/BNO055.zen")
DNP = Module("../../components/DNP/DNP.zen")
_32KHZ = Module("../../components/32kHz/32kHz.zen")

Capacitor(
    name="C10",
    package="0603",
    value="1uF",
    P1=NET_U4_CAP,
    P2=GND,
)

Capacitor(
    name="C11",
    package="0603",
    value="22pF",
    P1=GND,
    P2=IMU_XTAL,
)

Capacitor(
    name="C12",
    package="0603",
    value="22pF",
    P1=IMU_XTAL_2,
    P2=GND,
)

Capacitor(
    name="C13",
    package="0603",
    value="0.1uF",
    P1=GND,
    P2=NET_3_3V,
)

Capacitor(
    name="C19",
    package="0603",
    value="0.1uF",
    P1=NET_3_3V,
    P2=GND,
)

Capacitor(
    name="C25",
    package="0603",
    value="0.1uF",
    P1=NET_3_3V,
    P2=GND,
)

Resistor(
    name="R14",
    package="0402",
    value="10k",
    P1=NET_3_3V,
    P2=NET_U4_NBOOT_LOAD_PIN,
)

Resistor(
    name="R15",
    package="0402",
    value="10k",
    P1=NET_3_3V,
    P2=IMU_IMU_NRST,
)

Resistor(
    name="R17",
    package="0402",
    value="10k",
    P1=NET_3_3V,
    P2=IMU_ADDR_SEL,
)

Resistor(
    name="R18",
    package="0402",
    value="10k",
    P1=IMU_ADDR_SEL,
    P2=GND,
)

BNO055(
    name="U4",
    CAP=NET_U4_CAP,
    COM0=IMU_BNO_SDA,
    COM1=IMU_BNO_SCL,
    COM2=GND,
    COM3=IMU_ADDR_SEL,
    GND=GND,
    GNDIO=GND,
    INT=IMU_IMU_INT,
    NBOOT_LOAD_PIN=NET_U4_NBOOT_LOAD_PIN,
    NRESET=IMU_IMU_NRST,
    PIN10=NotConnected(),
    PIN15=NotConnected(),
    PIN16=NotConnected(),
    PS0=GND,
    PS1=GND,
    VDD=NET_3_3V,
    VDDIO=NET_3_3V,
    XIN32=IMU_XTAL,
    XOUT32=IMU_XTAL_2,
)

_32KHZ(name="Y1", P1=IMU_XTAL, P2=IMU_XTAL_2)


