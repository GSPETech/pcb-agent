Board = Module("../src/board.zen")

def default(module, inputs):
    components = module.components()
    check("R1.R" in components, "R1 present")
    check("D1.LED" in components, "D1 present")
    check("C1.C" in components, "C1 present")
    check("L1.L" in components, "L1 present")
    check("FB1.FB" in components, "FB1 present")
    check("TH1.TH" in components, "TH1 present")
    check("DZ1.D" in components, "DZ1 present")
    check("D2.D" in components, "D2 present")
    check("D3.D" in components, "D3 present")

TestBench(
    name = "ProductionExpression",
    module = Board,
    test_cases = {"default": {}},
    checks = [default],
)
