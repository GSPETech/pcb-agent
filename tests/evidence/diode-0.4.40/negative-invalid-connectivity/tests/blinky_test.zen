Blinky = Module("../src/blinky.zen")

def connectivity(module, inputs):
    nets = module.nets()
    check(nets.get("VCC", []) == [("ConnectivityTest__default.R1.R", "1")], "VCC must contain only R1.P1")
    check(nets.get("GND", []) == [("ConnectivityTest__default.D1.LED", "K")], "GND must contain D1.K")
    led_anode = nets.get("LED_ANODE", [])
    check(len(led_anode) == 2, "LED_ANODE must have exactly two members")
    check(("ConnectivityTest__default.R1.R", "2") in led_anode, "LED_ANODE must contain R1.P2")
    check(("ConnectivityTest__default.D1.LED", "A") in led_anode, "LED_ANODE must contain D1.A")

TestBench(
    name = "ConnectivityTest",
    module = Blinky,
    test_cases = {"default": {}},
    checks = [connectivity],
)
