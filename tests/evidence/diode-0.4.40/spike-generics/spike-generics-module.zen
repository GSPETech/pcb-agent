Resistor = Module("@stdlib/generics/Resistor.zen")
Led = Module("@stdlib/generics/Led.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Crystal = Module("@stdlib/generics/Crystal.zen")
Inductor = Module("@stdlib/generics/Inductor.zen")
FerriteBead = Module("@stdlib/generics/FerriteBead.zen")
Thermistor = Module("@stdlib/generics/Thermistor.zen")
Zener = Module("@stdlib/generics/Zener.zen")
Rectifier = Module("@stdlib/generics/Rectifier.zen")
Tvs = Module("@stdlib/generics/Tvs.zen")

VCC = Power()
GND = Ground()
LED_ANODE = Net()
VIN = Net()
XIN_NET = Net()
XOUT_NET = Net()
XIN_NET2 = Net()
XOUT_NET2 = Net()
MID = Net()

Resistor(name="R1", value="1kohm", package="0402", P1=VCC, P2=LED_ANODE)
Led(name="D1", package="0402", color="red", A=LED_ANODE, K=GND)
Capacitor(name="C1", value="100nF", package="0402", P1=VCC, P2=GND)
Crystal(name="Y1", frequency="8MHz", package="3215_2Pin", XIN=XIN_NET, XOUT=XOUT_NET)
Crystal(name="Y2", frequency="16MHz", package="3225_4Pin", XIN=XIN_NET2, XOUT=XOUT_NET2, GND=GND)
Inductor(name="L1", value="10uH", package="0402", P1=VIN, P2=MID)
FerriteBead(name="FB1", package="0402", P1=VIN, P2=MID)
Thermistor(name="TH1", value="10kohm", package="0402", P1=VIN, P2=MID)
Zener(name="DZ1", zener_voltage="3.3V", package="SOD-123", A=GND, K=VIN)
Rectifier(name="D2", reverse_voltage="40V", package="SOD-123", A=GND, K=VIN)
Tvs(name="D3", reverse_standoff_voltage="5V", package="DO-219AB", A=GND, K=VIN)

Board(name="spike_all_generics", layers=4, layout_path="layout/spike_all_generics")
