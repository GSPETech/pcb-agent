Resistor = Module("@stdlib/generics/Resistor.zen")
Led = Module("@stdlib/generics/Led.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Inductor = Module("@stdlib/generics/Inductor.zen")
FerriteBead = Module("@stdlib/generics/FerriteBead.zen")
Tvs = Module("@stdlib/generics/Tvs.zen")

VCC = Power()
GND = Ground()
LED_ANODE = Net()
INDUCTOR_MID = Net()
FB_MID = Net()

Resistor(name="R1", value="1kohm", package="0402", P1=VCC, P2=LED_ANODE)
Led(name="D1", package="0402", color="red", A=LED_ANODE, K=GND)
Capacitor(name="C1", value="100nF", package="0402", P1=VCC, P2=GND)
Inductor(name="L1", value="10uH", package="0402", P1=VCC, P2=INDUCTOR_MID)
FerriteBead(name="FB1", package="0402", P1=VCC, P2=FB_MID)
Tvs(name="D3", reverse_standoff_voltage="5V", package="DO-219AB", A=GND, K=VCC)

Board(name="green_real", layers=4, layout_path="layout/green_real")
