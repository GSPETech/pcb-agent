Resistor = Module("@stdlib/generics/Resistor.zen")
Led = Module("@stdlib/generics/Led.zen")

VCC = Power()
GND = Ground()
LED_ANODE = Net()

Resistor(name="R1", value="1kohm", package="0402", P1=VCC, P2=LED_ANODE)
# Deliberate topology defect: cathode must connect to GND, not VCC.
Led(name="D1", package="0402", color="red", A=LED_ANODE, K=VCC)
Board(name="invalid_connectivity", layers=4, layout_path="layout/invalid_connectivity")
