# Python/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Agent sessions and secrets
.agents/session*/
.claude/settings.local.json
.gemini/settings.local.json
.env
.env.*
!.env.example
*.key
*.pem

# Generated verification output
reports/
verify-report.json
verify-report.md
*.log
*.tmp
*.bak

# Repository-owned spike evidence must stay tracked even though it lives under
# a `reports/`-shaped path and carries verify-report.json / .md names.
!tests/evidence/
!tests/evidence/**

# The example board retains one verification report as evidence that the layout
# gates ran, so it is exempt from the report exclusions above.
!examples/**/verification/
!examples/**/verification/**

# Diode transient state
.pcb/cache/
.pcb/tmp/
.pcb/

# KiCad transient files; maintained .kicad_pcb files stay tracked
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
~*.lck

# The example board keeps its project-local settings so it opens as a complete
# KiCad project, and one build log as evidence of the run.
!examples/**/*.kicad_prl
!examples/**/layout.log

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Packaging artifacts
*.egg-info/
build/
dist/

# Archives and vendor drops: this repository holds the harness only. Board
# projects, deliverables and scratch exports live outside it.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.step
*.STEP
*.stp
*.xlsx
*.xls

# Third-party / imported board trees that are not part of the harness.
/dwm1004c_aptwr_tag_delivery/
/dwm1004c_aptwr_tag_pcb_package/
/dwm_tag_passive/
/diodeinc_scratch_package/
.history/
