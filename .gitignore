# Python/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Agent sessions and secrets
.agents/session*/
.claude/settings.local.json
.gemini/settings.local.json
.env
.env.*
!.env.example
*.key
*.pem

# Generated verification output
reports/runs/
reports/raw/
verify-report.json
verify-report.md
*.log
*.tmp
*.bak

# Repository-owned spike evidence must stay tracked even though it carries
# verify-report.json / verify-report.md names.
!tests/evidence/
tests/evidence/**/verify-report.json
tests/evidence/**/verify-report.md
!tests/evidence/**/verify-report.json
!tests/evidence/**/verify-report.md

# Diode transient state
.pcb/cache/
.pcb/tmp/
.pcb/

# KiCad transient files; maintained .kicad_pcb files stay tracked
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
~*.lck

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
