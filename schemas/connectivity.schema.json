{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcb-agent.local/schemas/connectivity.schema.json",
  "title": "Expected PCB connectivity (documentation only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "components", "nets", "rules"],
  "properties": {
    "schema_version": {"const": "1"},
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "value": {"type": "string"},
          "package": {"type": "string"},
          "mpn": {
            "type": "string",
            "description": "Manufacturer part number, kept for documentation completeness. No captured adapter provides a verified mpn accessor, so any specification requirement that asserts mpn is rejected by the generator (fail closed)."
          }
        }
      }
    },
    "nets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["members"],
        "properties": {
          "members": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[^.]+(\\.[^.]+)+$"}, "uniqueItems": true},
          "required_pullup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "rail"],
            "properties": {"component": {"type": "string"}, "rail": {"type": "string"}}
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbid_unlisted_members", "required_power_nets"],
      "properties": {
        "forbid_unlisted_members": {"type": "boolean"},
        "required_power_nets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
